# ============================================================
# BhoomiSatya - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-string
APP_BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bhoomisatya:bhoomisatya@localhost:5432/bhoomisatya

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=my-verify-token
WHATSAPP_APP_SECRET=

# --- Bhashini (Free Government API for Telugu) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Scraping ---
PROXY_URL=
CAPTCHA_SOLVER_API_KEY=
PLAYWRIGHT_HEADLESS=true

# --- Sentry (optional) ---
SENTRY_DSN=
